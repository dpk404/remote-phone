<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageButton
                android:id="@+id/backButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="-10dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_back"
                android:tint="@color/text_secondary"
                android:contentDescription="Back" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="Settings"
                android:textSize="22sp"
                style="@style/Title"
                android:letterSpacing="-0.01" />
        </LinearLayout>

        <TextView
            style="@style/Label"
            android:layout_marginStart="4dp"
            android:layout_marginTop="18dp"
            android:text="WHO MAY CONNECT" />

        <LinearLayout
            style="@style/Card"
            android:layout_marginTop="8dp"
            android:showDividers="middle"
            android:divider="@drawable/divider"
            android:dividerPadding="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingTop="16dp"
                android:paddingBottom="16dp"
                android:paddingStart="20dp"
                android:paddingEnd="20dp">

                <LinearLayout
                    style="@style/TextColumn"
                    android:layout_marginStart="0dp">

                    <TextView
                        style="@style/Title"
                        android:text="Ask before a computer connects" />

                    <TextView
                        style="@style/Body"
                        android:layout_marginTop="3dp"
                        android:text="Off lets any computer on the network watch and control this phone." />
                </LinearLayout>

                <Switch
                    android:id="@+id/askToggle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:contentDescription="Ask before a computer connects" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingTop="16dp"
                android:paddingBottom="16dp"
                android:paddingStart="20dp"
                android:paddingEnd="20dp">

                <LinearLayout
                    style="@style/TextColumn"
                    android:layout_marginStart="0dp">

                    <TextView
                        style="@style/Title"
                        android:text="Remember allowed computers" />

                    <TextView
                        style="@style/Body"
                        android:layout_marginTop="3dp"
                        android:text="Later sessions connect without asking again." />
                </LinearLayout>

                <Switch
                    android:id="@+id/rememberToggle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:contentDescription="Remember allowed computers" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingTop="16dp"
                android:paddingBottom="16dp"
                android:paddingStart="20dp"
                android:paddingEnd="20dp">

                <LinearLayout
                    style="@style/TextColumn"
                    android:layout_marginStart="0dp">

                    <TextView
                        style="@style/Title"
                        android:text="Allow several computers at once" />

                    <TextView
                        style="@style/Body"
                        android:layout_marginTop="3dp"
                        android:text="Off rejects a second computer while one is connected." />
                </LinearLayout>

                <Switch
                    android:id="@+id/multipleToggle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:contentDescription="Allow several computers at once" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:orientation="horizontal">

            <TextView
                style="@style/Label"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="REMEMBERED COMPUTERS" />

            <TextView
                android:id="@+id/rememberedCount"
                style="@style/Label" />
        </LinearLayout>

        <LinearLayout
            style="@style/Card"
            android:layout_marginTop="8dp"
            android:showDividers="middle"
            android:divider="@drawable/divider"
            android:dividerPadding="20dp">

            <!-- Rows from item_computer; the 6dp start lines them up with the card's 20dp inset -->
            <LinearLayout
                android:id="@+id/rememberedList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="6dp"
                android:paddingEnd="4dp"
                android:showDividers="middle"
                android:divider="@drawable/divider"
                android:dividerPadding="14dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="20dp"
                android:paddingEnd="12dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp">

                <TextView
                    android:id="@+id/rememberedFooter"
                    style="@style/Body"
                    android:layout_width="0dp"
                    android:layout_weight="1" />

                <Button
                    android:id="@+id/forgetButton"
                    style="@style/RowAction"
                    android:text="Forget all" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            style="@style/Label"
            android:layout_marginStart="4dp"
            android:layout_marginTop="18dp"
            android:text="ABOUT" />

        <LinearLayout
            style="@style/Card"
            android:layout_marginTop="8dp"
            android:showDividers="middle"
            android:divider="@drawable/divider"
            android:dividerPadding="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingTop="16dp"
                android:paddingBottom="16dp"
                android:paddingStart="20dp"
                android:paddingEnd="20dp">

                <TextView
                    style="@style/Title"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="Version" />

                <TextView
                    android:id="@+id/versionText"
                    style="@style/Body" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/sourceRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="60dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:background="?android:attr/selectableItemBackground">

                <LinearLayout
                    style="@style/TextColumn"
                    android:layout_marginStart="0dp">

                    <TextView
                        style="@style/Title"
                        android:text="Source code" />

                    <TextView
                        style="@style/Body"
                        android:layout_marginTop="2dp"
                        android:text="github.com/dpk404/remote-phone" />
                </LinearLayout>

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="8dp"
                    android:src="@drawable/ic_chevron"
                    android:importantForAccessibility="no" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
